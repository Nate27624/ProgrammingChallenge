{
  "model_name": "bilstm_attention",
  "feature_type": "mfcc",
  "n_features": 64,
  "hidden_size": 256,
  "num_layers": 2,
  "dropout": 0.3,
  "mamba_d_model": 96,
  "mamba_d_state": 32,
  "mamba_d_conv": 4,
  "mamba_expand": 2,
  "cnn_channels": 64,
  "frontend_type": "basic_cnn",
  "fusion_type": "concat",
  "pooling_type": "meanmax",
  "batch_size": 32,
  "learning_rate": 0.0003,
  "weight_decay": 0.0001,
  "optimizer_type": "adamw",
  "sam_rho": 0.05,
  "max_grad_norm": 5.0,
  "mixup_alpha": 0.0,
  "mixup_prob": 0.0,
  "loss_type": "ce",
  "focal_gamma": 2.0,
  "class_weighting": false,
  "label_smoothing": 0.1,
  "scheduler_type": "warmup_cosine",
  "warmup_epochs": 5,
  "min_lr_ratio": 0.01,
  "num_epochs": 70,
  "use_swa": false,
  "swa_start_epoch": 60,
  "swa_lr": 0.0001,
  "patience": 16,
  "patience_lr": 6,
  "val_split": 0.15,
  "num_folds": 3,
  "fold_index": 1,
  "include_deltas": true,
  "specaugment": true,
  "num_time_masks": 2,
  "time_mask_param": 50,
  "num_freq_masks": 2,
  "freq_mask_param": 16,
  "speed_perturb_prob": 0.2,
  "speed_perturb_min": 0.9,
  "speed_perturb_max": 1.1,
  "num_workers": 0,
  "specaugment_on_gpu": true,
  "feature_cache_dir": "results/_feature_cache",
  "seed": 42
}